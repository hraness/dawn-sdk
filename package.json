{
  "name": "@hraness/dawn-sdk",
  "version": "0.66.0",
  "license": "MIT",
  "type": "module",
  "description": "Build sounds, sound packs and collections for DAWN, write song scores with its TypeScript SDK, and render them to audio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/dawn-sdk.git"
  },
  "homepage": "https://github.com/hraness/dawn-sdk#readme",
  "files": [
    "core",
    "src",
    "assets",
    "docs",
    "examples",
    "extension-manifest.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "bun scripts/check.ts"
  },
  "bin": {
    "dawn-palette": "./src/palette/main.ts",
    "dawn-collection": "./src/collection/main.ts",
    "dawn-render": "./src/renderer/main.ts",
    "dawn-compose": "./src/composer-plugin/main.ts",
    "dawn-project": "./src/project/main.ts"
  },
  "exports": {
    ".": "./core/sdk/v1.ts",
    "./palette": "./core/palette.ts",
    "./collection": "./core/collection.ts",
    "./composer": "./core/composer-plugin.ts",
    "./render": "./src/renderer/cli.ts",
    "./browser": "./src/renderer/browser.ts",
    "./ui": "./core/ui/index.ts",
    "./ui/styles.css": "./core/ui/controls.css",
    "./score": "./core/score.ts",
    "./link": "./core/link/index.ts",
    "./diff": "./core/diff.ts",
    "./lint": "./core/lint/index.ts",
    "./comments": "./core/comments/events.ts",
    "./midi": "./core/midi.ts",
    "./trace": "./core/trace.ts",
    "./doc": "./src/doc/format.ts"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
